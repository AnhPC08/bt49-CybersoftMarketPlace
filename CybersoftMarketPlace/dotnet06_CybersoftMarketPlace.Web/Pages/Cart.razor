                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-danger fw-semibold small">₫189.000</span>
                    <span class="text-secondary small">Đã bán 1,2k</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card h-100 border">
            <img src="https://picsum.photos/id/48/300" class="card-img-top" alt="Bàn phím cơ" />
            <div class="card-body p-2">
                <p class="small mb-2">Bàn phím cơ RGB 87 phím, switch đỏ</p>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-danger fw-semibold small">₫650.000</span>
                    <span class="text-secondary small">Đã bán 856</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card h-100 border">
            <img src="https://picsum.photos/id/60/300" class="card-img-top" alt="Balo laptop" />
            <div class="card-body p-2">
                <p class="small mb-2">Balo laptop chống nước 15.6 inch</p>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-danger fw-semibold small">₫255.000</span>
                    <span class="text-secondary small">Đã bán 3,4k</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card h-100 border">
            <img src="https://picsum.photos/id/96/300" class="card-img-top" alt="Đồng hồ thông minh" />
            <div class="card-body p-2">
                <p class="small mb-2">Đồng hồ thông minh đo nhịp tim, chống nước</p>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-danger fw-semibold small">₫499.000</span>
                    <span class="text-secondary small">Đã bán 720</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card h-100 border">
            <img src="https://picsum.photos/id/106/300" class="card-img-top" alt="Giá đỡ điện thoại" />
            <div class="card-body p-2">
                <p class="small mb-2">Giá đỡ điện thoại nhôm, gập gọn</p>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-danger fw-semibold small">₫79.000</span>
                    <span class="text-secondary small">Đã bán 5,1k</span>
                </div>
            </div>
