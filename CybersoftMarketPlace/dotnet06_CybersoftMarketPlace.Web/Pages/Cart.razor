                    <span class="text-secondary small">Đã bán 2,8k</span>
                </div>
            </div>
        </div>
    </div>
</div>




@code {
    //Lấy dữ liệu giỏ hàng từ state service (hub trả về qua GetCartByUserId)
    private List<CartItemDTO> CartItems => _cartStateService.cartStateDTO.CartItems;

    //Tổng số lượng sản phẩm trong giỏ
    private int TotalQuantity => CartItems.Sum(item => item.Quantity);

    //Tổng tiền phải thanh toán
    private decimal TotalAmount => CartItems.Sum(item => item.Price * item.Quantity);

    //Định dạng tiền kiểu Việt Nam: 1200000 -> 1.200.000
    private static string FormatMoney(decimal value) => value.ToString("#,##0", new CultureInfo("vi-VN"));


    protected override async Task OnInitializedAsync()
    {
        _cartStateService.OnChange += OnCartStateChanged;

        //Kết nối websocket tới cart-hub (state service tự bỏ qua nếu chưa đăng nhập)
        await _cartStateService.StartHubConnectionAsync();

        //gọi load giỏ hàng mỗi khi vào trang (gọi api CartHub)
        await _cartStateService.LoadCartAsync();
    }


    public async Task ChangeQuantityAsync(int productVariantId, int newQuantity)
    {
        Console.WriteLine(@$"{productVariantId} - {newQuantity}");
        //Gọi hub để thay đổi số lượng sản phẩm trong giỏ hàng
        await _cartStateService.ChangeQuantityVariantInCart(productVariantId, newQuantity);
    }



    //Handler của hub chạy ngoài luồng UI nên phải bọc InvokeAsync
    private void OnCartStateChanged() => InvokeAsync(StateHasChanged);


    public async ValueTask DisposeAsync()
    {
        _cartStateService.OnChange -= OnCartStateChanged;

        //Huỷ kết nối websocket khi component bị hủy
        await _cartStateService.StopHubConnectionAsync();
    }
}




